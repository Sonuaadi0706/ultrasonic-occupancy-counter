# ── Turso (leave empty locally to use ./local.db, auto-seeded with 14 days of history)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── MQTT. Leave all empty to use the free public broker broker.emqx.io (random topic prefix,
#    see src/lib/mqtt-config.ts). For EMQX Cloud set your own URLs + credentials below.
# Server-side (publishes commands in Real mode).
MQTT_URL=
MQTT_WRITE_USERNAME=server-write
MQTT_WRITE_PASSWORD=

# Browser-side (read-only live view).
NEXT_PUBLIC_MQTT_URL=
NEXT_PUBLIC_MQTT_USERNAME=web-readonly
NEXT_PUBLIC_MQTT_PASSWORD=
# Optional topic root override (default: "counter", or the random prefix on broker.emqx.io)
NEXT_PUBLIC_MQTT_TOPIC_PREFIX=
# Bridge / mock device broker (plain MQTT)
DEVICE_MQTT_URL=

# ── Device ingestion (ESP32 → POST /api/ingest/event)
INGEST_TOKEN=change-me

# ── Optional
NEXT_PUBLIC_DEVICE_ID=room-01
NEXT_PUBLIC_DEVICE_NAME=Main Room
